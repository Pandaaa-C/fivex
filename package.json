{
	"name": "@panda0day/fivex",
	"version": "0.4.0",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"exports": {
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./shared": {
			"types": "./dist/shared/index.d.ts",
			"default": "./dist/shared/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
		"prepare": "npm run build",
		"typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"docs": "typedoc",
		"check": "npm run format && npm run typecheck && npm run build"
	},
	"peerDependencies": {
		"@citizenfx/client": "*",
		"@citizenfx/server": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@changesets/cli": "^3.0.2",
		"@citizenfx/client": "^2.0.35214-1",
		"@citizenfx/server": "^2.0.35214-1",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3"
	}
}
